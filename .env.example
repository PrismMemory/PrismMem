# Copy to .env. Fill every URL/key pair for the roles you will run.
# OpenAI-compatible routes require explicit URLs; no SDK default endpoint is used.

# text-embedding-v4 (OpenAI-compatible embedding endpoint)
PRISM_BASE_URL=
PRISM_API_KEY=

# glm-5.2 extraction endpoint
PRISM_EXTRACTION_BASE_URL=
PRISM_EXTRACTION_API_KEY=

# Shared answer/judge route, retained for compatibility.
PRISM_QA_BASE_URL=
PRISM_QA_API_KEY=

# Optional independent pairs. Set BOTH fields to override the shared QA route.
PRISM_ANSWER_BASE_URL=
PRISM_ANSWER_API_KEY=
PRISM_JUDGE_BASE_URL=
PRISM_JUDGE_API_KEY=

# qwen3-rerank native API credential. Blank URL selects the DashScope SDK route.
PRISM_RERANK_API_KEY=
PRISM_RERANK_BASE_URL=

# Blank model entries use these defaults respectively:
# glm-5.2, text-embedding-v4, qwen3-rerank, gpt-4o-mini, gpt-4.1-mini.
PRISM_EXTRACTION_MODEL=
PRISM_MODEL=
PRISM_RERANK_MODEL=
PRISM_ANSWER_MODEL=
PRISM_JUDGE_MODEL=

# Default extraction and retrieval options
PRISM_EXTRACTION_ENABLE_THINKING=0
PRISM_QA_ENABLE_THINKING=0
PRISM_BM25_LEMMATIZATION=1
PRISM_BM25_AUTO_DOWNLOAD=1
